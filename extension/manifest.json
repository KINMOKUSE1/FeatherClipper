{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Vid2Notes",
  "version": "1.3.5",
  "description": "Video subtitles to Obsidian. 收集 B站与 YouTube 课程字幕。",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://api.bilibili.com/*",
    "https://*.hdslb.com/*",
    "https://*.bilivideo.com/*",
    "https://*.googlevideo.com/*",
    "https://api.groq.com/*",
    "https://api.siliconflow.cn/*",
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "http://localhost/*",
    "https://localhost/*"
  ],
  "background": {
    "service_worker": "background/index.js"
  },
  "icons": {
    "16": "shared/icons/icon16.png",
    "32": "shared/icons/icon32.png",
    "48": "shared/icons/icon48.png",
    "128": "shared/icons/icon128.png"
  },
  "options_page": "workbench/index.html",
  "action": {
    "default_title": "Vid2Notes · 导入 Obsidian",
    "default_icon": {
      "16": "shared/icons/icon16.png",
      "32": "shared/icons/icon32.png"
    },
    "default_popup": "popup/index.html"
  }
}
